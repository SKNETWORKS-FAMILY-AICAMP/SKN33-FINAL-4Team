{
  "paths": {
    "/api/policies/regions/": {
      "get": {
        "summary": "사는 지역 목록",
        "operationId": "policyRegions",
        "tags": [
          "청년 정책"
        ],
        "x-source": "docs/api/policies.md",
        "description": "시도 16개와 그 아래 고를 수 있는 시군구. 구가 있는 시는 구까지, 세종은 시도 자신이 시군구다. 온보딩·내 정보·채팅 정책 지역 선택이 같은 목록을 쓰며, regions[].code를 PUT /api/profile/의 regionCode로 보낸다.",
        "responses": {
          "200": {
            "description": "시도 → 시군구 목록.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyRegionsResponse"
                },
                "example": {
                  "items": [
                    {
                      "code": "11000",
                      "name": "서울특별시",
                      "regions": [
                        {
                          "code": "11110",
                          "name": "종로구"
                        },
                        {
                          "code": "11620",
                          "name": "관악구"
                        }
                      ]
                    },
                    {
                      "code": "36110",
                      "name": "세종특별자치시",
                      "regions": [
                        {
                          "code": "36110",
                          "name": "세종특별자치시"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "로그인하지 않음: not_authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/policies/saved/": {
      "get": {
        "summary": "저장한 정책 목록",
        "operationId": "policySavedList",
        "tags": [
          "청년 정책"
        ],
        "x-source": "docs/api/policies.md",
        "description": "저장한 정책을 최신 저장순으로. 마감·수집 종료(active=false)된 정책도 지우지 않고 상태로 보여 준다. 화면(마이 → 저장한 정책)은 신청할 수 있는 정책을 위에, 지난 정책을 아래에 접어 둔다.",
        "responses": {
          "200": {
            "description": "저장 목록. 없으면 items: [].",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedPolicyListResponse"
                },
                "example": {
                  "items": [
                    {
                      "savedPolicyId": "3f2c9a10-7b6d-4e21-9c8a-1d2e3f4a5b6c",
                      "policyNo": "20261021005400214208",
                      "name": "2026 청년 월세 지원",
                      "applyState": "open",
                      "applyEnd": "2026-12-31",
                      "link": "https://www.youthcenter.go.kr/",
                      "active": true,
                      "region": "서울특별시",
                      "supportType": null,
                      "support": "월 최대 20만 원, 최대 12개월 월세 지원",
                      "savedAt": "2026-11-10T15:30:00+09:00"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "로그인하지 않음: not_authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/policies/{policyNo}/saved/": {
      "parameters": [
        {
          "name": "policyNo",
          "in": "path",
          "required": true,
          "description": "온통청년 정책번호 (20자리 숫자 문자열, UUID 아님). 없는 번호·형식이 틀린 번호는 404",
          "schema": {
            "type": "string",
            "pattern": "^[0-9]{20}$"
          }
        }
      ],
      "put": {
        "summary": "정책 저장",
        "operationId": "policySave",
        "tags": [
          "청년 정책"
        ],
        "x-source": "docs/api/policies.md",
        "description": "채팅 정책 카드의 [저장]. 이미 저장한 정책이어도 200으로 같은 칸을 돌려주므로(두 번 눌러도 한 줄) Idempotency-Key가 필요 없다. 본문은 보내지 않거나 {}만.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "저장한 정책 한 칸.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedPolicy"
                },
                "example": {
                  "savedPolicyId": "3f2c9a10-7b6d-4e21-9c8a-1d2e3f4a5b6c",
                  "policyNo": "20261021005400214208",
                  "name": "2026 청년 월세 지원",
                  "applyState": "open",
                  "applyEnd": "2026-12-31",
                  "link": "https://www.youthcenter.go.kr/",
                  "active": true,
                  "region": "서울특별시",
                  "supportType": null,
                  "support": "월 최대 20만 원, 최대 12개월 월세 지원",
                  "savedAt": "2026-11-10T15:30:00+09:00"
                }
              }
            }
          },
          "400": {
            "description": "본문에 칸을 보냄: invalid. 잘못된 JSON: parse_error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "로그인하지 않음: not_authenticated. CSRF 검증 실패: permission_denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "없는 정책번호·수집이 끝난 정책: not_found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "정책 저장 취소",
        "operationId": "policyUnsave",
        "tags": [
          "청년 정책"
        ],
        "x-source": "docs/api/policies.md",
        "description": "저장돼 있지 않아도 204(이미 원하는 상태). 수집이 끝난 정책도 취소할 수 있다.",
        "responses": {
          "204": {
            "description": "본문 없음."
          },
          "403": {
            "description": "로그인하지 않음: not_authenticated. CSRF 검증 실패: permission_denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "없는 정책번호: not_found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PolicyRegionsResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "name",
                "regions"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "regions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "code",
                      "name"
                    ],
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "SavedPolicy": {
        "type": "object",
        "required": [
          "savedPolicyId",
          "policyNo",
          "name",
          "applyState",
          "applyEnd",
          "link",
          "active",
          "region",
          "supportType",
          "support",
          "savedAt"
        ],
        "properties": {
          "savedPolicyId": {
            "type": "string",
            "format": "uuid"
          },
          "policyNo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "applyState": {
            "type": "string",
            "enum": [
              "open",
              "always",
              "upcoming",
              "unknown",
              "closed"
            ],
            "description": "신청 중 · 상시 · 신청 예정 · 기간 확인 필요 · 마감"
          },
          "applyEnd": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "마지막 신청 마감일. 상시·기간 모름이면 null"
          },
          "link": {
            "type": "string",
            "nullable": true,
            "description": "신청 주소, 없으면 참고 주소"
          },
          "active": {
            "type": "boolean",
            "description": "정책 수집에서 사라졌으면 false"
          },
          "region": {
            "type": "string",
            "nullable": true,
            "description": "대상 지역 한 줄 (전국 · 서울특별시 · 경기도 수원시 외 2곳 …)"
          },
          "supportType": {
            "type": "string",
            "nullable": true,
            "description": "대출·보증일 때만 (대출 · 상환 필요 / 대출 보증 · 지원금 아님)"
          },
          "support": {
            "type": "string",
            "nullable": true,
            "description": "지원 내용 앞부분 (원문을 자르기만 함)"
          },
          "savedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SavedPolicyListResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SavedPolicy"
            }
          }
        }
      }
    }
  }
}
